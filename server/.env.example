# Copy of the local settings. setup.ps1 and setup.sh create server/.env
# from this file. server/.env is gitignored — do not commit secrets.

PORT=3000

# Auth needs MongoDB. The site still starts when this database is down.
MONGODB_URI=mongodb://127.0.0.1:27017/signbridge

# The setup script replaces this placeholder with a random value.
JWT_SECRET=replace-with-a-long-random-string

JWT_EXPIRES_IN=7d

# Local Python model API (ml/api.py). Change this if the team shares one model server.
LSTM_API_URL=http://127.0.0.1:9001/predict
